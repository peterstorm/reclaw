{
  "requireGovernance": [
    "src/"
  ],
  "boundaries": [
    {
      "module": "src/core/",
      "description": "Functional core: pure domain logic, ports and parsers; imports itself and pure libraries only, never infra/orchestration",
      "allow": [
        "./",
        "src/core/",
        "zod",
        "yaml",
        "ts-pattern",
        "cron-parser",
        "ts-fsrs",
        "chrono-node",
        "vitest",
        "fast-check"
      ],
      "deny": [
        "src/infra/",
        "src/orchestration/",
        "src/main.ts",
        "node:"
      ]
    },
    {
      "module": "src/infra/",
      "description": "Adapters: Redis/BullMQ, Telegram, filesystem, subprocesses, HTTP; implement core ports, never call orchestration",
      "allow": [
        "./",
        "src/infra/",
        "src/core/",
        "node:",
        "bullmq",
        "ioredis",
        "grammy",
        "chokidar",
        "unpdf",
        "notebooklm-kit",
        "zod",
        "ts-pattern",
        "vitest",
        "fast-check"
      ],
      "deny": [
        "src/orchestration/",
        "src/main.ts"
      ]
    },
    {
      "module": "src/orchestration/",
      "description": "Shell orchestrators: wire core decisions to infra adapters (reclaw convention, workspace architecture.md: orchestration may import infra adapters directly); never the composition root",
      "allow": [
        "./",
        "src/orchestration/",
        "src/core/",
        "src/infra/",
        "node:",
        "bullmq",
        "ioredis",
        "cron-parser",
        "ts-pattern",
        "vitest",
        "fast-check"
      ],
      "deny": [
        "src/main.ts"
      ]
    },
    {
      "module": "src/main.ts",
      "description": "Composition root: builds adapters and hands them to orchestrators",
      "allow": [
        "./",
        "src/",
        "node:",
        "ioredis"
      ],
      "deny": []
    },
    {
      "module": "src/main.test.ts",
      "description": "Composition-root tests",
      "allow": [
        "./",
        "src/",
        "node:",
        "ioredis",
        "vitest",
        "fast-check"
      ],
      "deny": []
    }
  ],
  "pureModules": [
    "src/core/"
  ],
  "maxFunctionLines": 50,
  "excludeFromMaxLines": [
    ".test.ts",
    ".spec.ts"
  ],
  "docReferences": {
    "govern": [
      {
        "path": "docs/",
        "reason": "the project's documentation describes the tree as it is"
      },
      {
        "path": "README.md",
        "reason": "the entry document names the commands and files a reader starts from"
      },
      {
        "path": "CONTEXT.md",
        "reason": "the ubiquitous language names the code that realizes each term"
      }
    ],
    "plans": [
      {
        "path": ".claude/plans/",
        "reason": "a plan cites its spec's ids and ADRs; it names files not built yet, so only those are resolved"
      }
    ],
    "sourceRoots": [
      "src"
    ]
  },
